{
  "name": "rpg-viewer",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "vite build && vite preview",
    "test": "vitest run",
    "diagnose": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/ts-alias-hooks.mjs scripts/diagnose-game.ts",
    "mask": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/ts-alias-hooks.mjs scripts/mask-game.ts",
    "unmask": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/ts-alias-hooks.mjs scripts/unmask-game.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "acorn": "^8.19.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.63.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
