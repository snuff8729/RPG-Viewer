{
  "id": "ddaggeo-mode",
  "label": "따거모드 그림 구분",
  "description": "CallStand·CallCutin·Ticker를 쓰는 게임에 맞춘 그림 구분이에요. 게이지(101–103)는 화면 장식, 111–150번은 스탠딩, 60번은 이벤트 그림으로 보고, 컷인 겹(actor01_cutin, organ/ 등)은 작아도 스탠딩으로 남겨요. 화면 그림 따라 그리기와 알림 문구 기록을 함께 켜요.",
  "match": { "plugins": ["CallStand", "CallCutin", "Ticker"], "pluginsMode": "all" },
  "defaults": {
    "addons": { "screenPictures": true, "notices": true },
    "pictureRoles": { "60": "cg", "101-103": "decoration", "111-150": "stand" },
    "spriteRoles": {
      "actor01_cutin_*": "stand",
      "organ/": "stand",
      "mark/": "stand",
      "clit/": "stand",
      "nipple/": "stand",
      "eye/": "stand",
      "TickerTest*": "decoration"
    }
  }
}
